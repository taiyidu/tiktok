<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.taiyidu.taiyidu.gongsheng.mapper.UserMapper">
    <update id="updateUser">
        update sys_user set
                            <if test="username != null">username = #{username},</if>
                            <if test="password != null">password = #{password},</if>
                            <if test="email != null">email = #{email},</if>
                            <if test="status != null">status = #{status},</if>
                            <if test="remain != null">remain = #{remain}</if>
        where id = #{id}
    </update>

    <select id="getByUsername" resultType="com.taiyidu.taiyidu.gongsheng.pojo.entity.User">
        select * from sys_user where username = #{username}
    </select>
    <select id="getById" resultType="com.taiyidu.taiyidu.gongsheng.pojo.entity.User">
        select * from sys_user where id = #{id}
    </select>
</mapper>
